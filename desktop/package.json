{
  "name": "t-rex-desktop",
  "productName": "T-Rex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "T-Rex as a Mac app: the bridge and its runtimes inside, herdr from the PC or bundled.",
  "license": "MIT",
  "author": "Alexander Kreidich",
  "main": "out/main.js",
  "scripts": {
    "build": "bun build src/main.ts --target=node --format=esm --external electron --outfile out/main.js",
    "typecheck": "../node_modules/.bin/tsc -p .",
    "bridge": "bun scripts/stage-bridge.ts",
    "start": "bun run build && electron .",
    "dist": "bun run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  }
}
